{
  "manifest_version": 3,
  "name": "Ward",
  "description": "Go to ward",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/icon.png"
  },
  "permissions": [
    "unlimitedStorage",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://github.com/"
  ],
  "commands": {
    "add-highlight": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "선택한 텍스트를 Ward 하이라이트로 추가"
    }
  }
}
